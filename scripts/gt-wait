#!/bin/zsh
# gt-wait <id> [--for PATTERN] [--timeout SECONDS] [--interval SECONDS]
# Pattern mode (--for): block until PATTERN (grep -E) appears on the screen. Exit 1 on timeout.
# Settle mode (no --for): block until two consecutive frames are identical (repaint finished).
# Note: spinners/progress bars never settle — use --for on animated screens.
set -euo pipefail

HERE="${0:A:h}"
TID="" PATTERN="" TIMEOUT=15 INTERVAL=0.15
while [[ $# -gt 0 ]]; do
  case "$1" in
    --for)      PATTERN="$2"; shift 2 ;;
    --timeout)  TIMEOUT="$2"; shift 2 ;;
    --interval) INTERVAL="$2"; shift 2 ;;
    -h|--help)  sed -n '2,5p' "$0"; exit 0 ;;
    *) TID="$1"; shift ;;
  esac
done
[[ -n "$TID" ]] || { echo "usage: gt-wait <id> [--for PATTERN] [--timeout N]" >&2; exit 2; }

DEADLINE=$(( $(date +%s) + TIMEOUT ))
PREV=""
while (( $(date +%s) < DEADLINE )); do
  FRAME=$("$HERE/gt-screen" "$TID" 2>/dev/null || true)
  if [[ -n "$PATTERN" ]]; then
    if printf '%s' "$FRAME" | grep -qE "$PATTERN"; then exit 0; fi
  else
    if [[ -n "$FRAME" && "$FRAME" == "$PREV" ]]; then exit 0; fi
    PREV="$FRAME"
  fi
  sleep "$INTERVAL"
done
echo "gt-wait: timeout after ${TIMEOUT}s${PATTERN:+ waiting for /$PATTERN/}" >&2
exit 1
